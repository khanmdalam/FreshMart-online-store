│   ├── services/            # api.js (Axios instance)
│   └── App.jsx              # Routes (React Router)







server/
├── models/
│   ├── User.js              # Name, Email, Address for delivery
│   ├── Product.js           # Name, Price, Category, Stock, ImageURL
│   ├── Category.js          # Fruits, Vegetables, Meat, etc.
│   └── Order.js             # Items, Total, Delivery Status, Date
├── routes/
│   ├── productRoutes.js     # GET /products, GET /products/:category
│   ├── userRoutes.js        # Auth & Profile
│   └── orderRoutes.js       # Stripe integration & order history
├── controllers/
│   ├── productController.js # Logic to filter by "Freshness" or "Price"
